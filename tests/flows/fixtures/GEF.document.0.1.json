            {
                "language": null,
                "type": "Text",
                "type_confidence": 0,
                "text": "Kenya National Adaptation Plan\n2015-2030",
                "id": "p_0_b_1",
                "idx": 1,
                "pages": [
                    {
                        "number": 0,
                        "bounding_boxes": [
                            {
                                "coordinates": [
